{
  "name": "harness-hub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Starport — local and group conversations with caller-owned computer agents and a mobile PWA",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
